# Ollama Server Configuration - Individual servers for each model
API_GEC_OLLAMA_URL=http://localhost:11434  # Grammar Error Correction server
API_GEE_OLLAMA_URL=http://localhost:11435  # Grammar Error Explanation server
API_GED_OLLAMA_URL=http://localhost:11436  # Grammar Error Detection server

# Model Names for different tasks
API_GEC_MODEL=gec  # Grammar Error Correction model
API_GEE_MODEL=gee  # Grammar Error Explanation model
API_GED_MODEL=ged  # Grammar Error Detection model

# API Configuration
API_MAX_INPUT_LENGTH=10000
API_LANGUAGES=et
API_VERSION=1.0.0